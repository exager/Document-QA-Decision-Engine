# Retrieval-Augmented Generation tunables. All keys prefixed RAG_.
# Safe to commit if you want per-branch defaults; also safe to gitignore
# for per-env overrides.

# --- Retrieval evaluator thresholds ---------------------------------
RAG_MIN_TOP_SCORE=0.4
RAG_MIN_CHUNKS_ABOVE_THRESHOLD=1
RAG_MAX_TOP_K=20

# --- Chunker strategy: character_v1 | structural_v1 | semantic_v1 ---
RAG_CHUNKER_STRATEGY=character_v1

# --- Chunker knobs ------------------------------------------------
RAG_CHUNK_TARGET_TOKENS=350
RAG_CHUNK_MAX_TOKENS=512
RAG_CHUNK_MIN_TOKENS=150
RAG_CHUNK_OVERLAP_SENTENCES=1
RAG_SEMANTIC_Z_SCORE=1.0
RAG_SEMANTIC_MIN_UNITS=4
